                           <pdfaProperty:category>internal</pdfaProperty:category>
                           <pdfaProperty:description>An unordered array of references to resources that were incorporated, by inclusion or reference, into this document.</pdfaProperty:description>
                           <pdfaProperty:name>Ingredients</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag ResourceRef</pdfaProperty:valueType>
                        </rdf:li>
